# ==============================================================================
# Transportes Seguros S.A. — Configuración de Entorno de Ejemplo
# Copie este archivo a .env o configure las variables en el entorno del sistema.
# NUNCA incluya credenciales reales ni claves privadas en el repositorio Git.
# ==============================================================================

# Conexión a Microsoft SQL Server 2025 (PDO_SQLSRV)
TSSA_DB_SERVER=127.0.0.1
TSSA_DB_DATABASE=TransportesSegurosSA_Test
TSSA_DB_USER=sa
TSSA_DB_PASSWORD=TuPasswordSeguro2026*
TSSA_DB_PORT=1433

# URL base pública de la aplicación para enlaces de activación y recuperación
TSSA_APP_URL=http://127.0.0.1:8085

# Proveedor de correo electrónico: 'brevo' para envíos reales vía API, 'fake' para pruebas/captura en memoria
TSSA_MAIL_TRANSPORT=fake

# Configuración del servicio Brevo (Sendinblue)
BREVO_API_KEY=xkeysib-tu-api-key-de-brevo-aqui
BREVO_SENDER_EMAIL=notificaciones@transportesseguros.cr
BREVO_SENDER_NAME=Transportes Seguros S.A.

# Integración con el Ministerio de Hacienda de Costa Rica (Tributación / RUC)
HACIENDA_API_URL=https://api.hacienda.go.cr/fe/ae
HACIENDA_TIMEOUT_SECONDS=5
