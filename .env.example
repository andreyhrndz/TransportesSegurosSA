# ==============================================================================
# Transportes Seguros S.A. — Plantilla de Configuración de Entorno (.env.example)
# ==============================================================================
# Copie este archivo a .env en la raíz del proyecto para desarrollo local:
#   Copy-Item .env.example .env
#
# REGLAS DE SEGURIDAD ESTRICTAS:
# - NUNCA versione credenciales reales, claves API ni certificados en Git.
# - El archivo .env está excluido por .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Conexión a Microsoft SQL Server 2025 (PDO_SQLSRV)
# ------------------------------------------------------------------------------
# Servidor o instancia de SQL Server (localhost, .\SQLEXPRESS, IP o hostname)
TSSA_DB_SERVER=localhost

# Base de datos de desarrollo y pruebas seguras (predeterminada: TransportesSegurosSA_Test)
# NOTA: Para consultar la base de datos de producción/original en modo lectura controlada,
# cambie a TransportesSegurosSA (requiere autorización y no se utiliza para pruebas con escrituras).
TSSA_DB_DATABASE=TransportesSegurosSA_Test

# Autenticación:
# Opción 1 (Recomendada en desarrollo local Windows): Windows Integrated Authentication.
# Deje TSSA_DB_USER y TSSA_DB_PASSWORD vacíos o comentados.
#
# Opción 2: SQL Server Authentication con usuario dedicado de mínimo privilegio.
# TSSA_DB_USER=
# TSSA_DB_PASSWORD=
# TSSA_DB_PORT=1433

# ------------------------------------------------------------------------------
# Servidor Web y URLs de la Aplicación
# ------------------------------------------------------------------------------
# URL base local donde escucha el servidor PHP de desarrollo (puerto 8001 por defecto)
TSSA_APP_URL=http://127.0.0.1:8001

# ------------------------------------------------------------------------------
# Servicio de Correo Electrónico (Notificaciones e Invitaciones)
# ------------------------------------------------------------------------------
# Proveedor: 'fake' para captura local sin envíos reales (recomendado en desarrollo),
# o 'brevo' para envíos transaccionales reales vía API de Brevo.
TSSA_MAIL_TRANSPORT=fake

# Configuración de Brevo (Sendinblue) — Requerido solo si TSSA_MAIL_TRANSPORT=brevo
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notificaciones@transportesseguros.cr
BREVO_SENDER_NAME=Transportes Seguros S.A.

# ------------------------------------------------------------------------------
# Integración Tributaria Ministerio de Hacienda de Costa Rica (API RUC / Cédulas)
# ------------------------------------------------------------------------------
HACIENDA_API_URL=https://api.hacienda.go.cr/fe/ae
HACIENDA_TIMEOUT_SECONDS=5
